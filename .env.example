# Replace both values before running Docker or deploying.
APP_ACCESS_PASSWORD="change-this-local-password"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Optional shared team report history (Neon/PostgreSQL). Leave blank for browser-only history.
DATABASE_URL=""

# Optional AI-assisted test-case generation. Keep this key server-side only.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Optional Lighthouse mobile audit for local/Docker only.
# Keep false by default. Enable only when auditing websites you own/are authorized to test.
ENABLE_LIGHTHOUSE="false"
LIGHTHOUSE_ALLOW_UNFILTERED_NETWORK="false"

BROWSER_NAVIGATION_TIMEOUT_MS="8000"

# Docker defaults: discover up to 10,000 pages for up to 10 minutes.
# Vercel uses its shorter discovery budget because serverless functions have execution limits.
MAX_DISCOVERED_PAGES="10000"
MAX_SITEMAP_FILES="100"
SITE_DISCOVERY_TIMEOUT_MS="600000"
